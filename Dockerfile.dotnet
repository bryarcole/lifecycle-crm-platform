FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
ARG PROJECT=src/Lifecycle.Api/Lifecycle.Api.csproj
COPY src/ src/
COPY db/ db/
COPY data/ data/
RUN dotnet restore "$PROJECT"
RUN dotnet publish "$PROJECT" --configuration Release --no-restore --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
CMD ["dotnet", "Lifecycle.Api.dll"]
