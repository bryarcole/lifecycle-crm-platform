{
  "name": "lifecycle-crm-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "dotnet run --project src/Lifecycle.Api/Lifecycle.Api.csproj",
    "dev:worker": "dotnet run --project src/Lifecycle.Worker/Lifecycle.Worker.csproj",
    "seed:customers": "dotnet run --project src/Lifecycle.Seeder/Lifecycle.Seeder.csproj --",
    "test": "dotnet test Lifecycle.slnx",
    "build:web": "npm --prefix apps/web run build",
    "check": "dotnet build Lifecycle.slnx"
  }
}
